# OpenSandbox Server 地址（本地部署默认如下）
OPENSANDBOX_DOMAIN=http://127.0.0.1:8080
# 沙箱镜像（可换成任意带 python3 的镜像，code-interpreter 镜像功能最全）
SANDBOX_IMAGE=sandbox-registry.cn-zhangjiakou.cr.aliyuncs.com/opensandbox/code-interpreter:v1.0.2

# 模型配置（默认走阿里云百炼 OpenAI 兼容接口）
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus

# Daytona 示例需要（海外 API，国内需代理）
DAYTONA_API_KEY=
DAYTONA_BASE_URL=https://app.daytona.io/api
OPENAI_API_KEY=
OPENAI_BASE_URL=